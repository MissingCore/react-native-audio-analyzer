{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["audioanalyzer"],
  "ios": {
    "iosModuleName": "AudioAnalyzer"
  },
  "android": {
    "androidNamespace": ["audioanalyzer"],
    "androidCxxLibName": "audioanalyzer"
  },
  "autolinking": {
    "Processor": {
      "all": {
        "language": "c++",
        "implementationClassName": "Processor"
      }
    },
    "FileSystem": {
      "ios": {
        "language": "swift",
        "implementationClassName": "FileSystem"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "FileSystem"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
